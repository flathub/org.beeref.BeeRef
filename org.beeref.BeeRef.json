{
    "id": "org.beeref.BeeRef",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "base": "com.riverbankcomputing.PyQt.BaseApp",
    "base-version": "6.11",
    "command": "beeref",
    "separate-locales": false,
    "rename-desktop-file": "beeref.desktop",
    "rename-icon": "logo",
    "finish-args": [
        "--share=network",
        "--socket=fallback-x11",
        "--share=ipc",
        "--filesystem=host",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "env": [
            "BASEAPP_REMOVE_WEBENGINE=1"
        ]
    },
    "cleanup-commands": [
        "/app/cleanup-BaseApp.sh"
    ],
    "modules": [
        "python3-modules.json",
        {
            "name": "BeeRef",
            "buildsystem": "simple",
            "build-commands": [
                "desktop-file-edit --set-key=Exec --set-value=beeref beeref.desktop",
                "desktop-file-edit --set-comment='Arrange and view your reference images' beeref.desktop",
                "desktop-file-edit --set-generic-name='Reference image viewer' beeref.desktop",
                "pip3 install --no-deps --prefix=/app . --no-build-isolation",
                "install -Dm644 beeref/assets/logo.svg -t /app/share/icons/hicolor/scalable/apps/",
                "install -Dm644 beeref.desktop -t /app/share/applications/",
                "install -Dm644 ${FLATPAK_ID}.appdata.xml -t /app/share/metainfo/"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/rbreu/beeref.git",
                    "tag": "v0.3.3",
                    "commit": "f53abad9c8ec34c12130464586d3750eea7279b7",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ]
        }
    ]
}
